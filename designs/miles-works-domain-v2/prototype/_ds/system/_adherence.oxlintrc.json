    ],
    "tokenKinds": {
      "--bg": "color",
      "--panel": "color",
      "--border": "color",
      "--border-strong": "color",
      "--text": "color",
      "--muted": "color",
      "--accent": "color",
      "--accent-deep": "color",
      "--tint": "color",
      "--success": "color",
      "--success-tint": "color",
      "--warning": "color",
